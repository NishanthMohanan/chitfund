# Copy to .env.test. Values here override .env when running `pnpm test`, so the
# e2e suites write to a separate database. The audit log is append-only, so a
# shared dev database would accumulate test rows that can never be removed.
NODE_ENV=test
LOG_LEVEL=fatal
DATABASE_URL=postgresql://chitfund:change-me@localhost:5432/chitfund_test
