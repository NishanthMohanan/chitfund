# Copy to .env and fill in real values. Never commit .env.
# Every setting lives here; the code has no built-in defaults.
# The API validates its variables at boot (apps/api/src/config/env.ts) and refuses
# to start if any are missing or invalid. The web dev server does the same for its own.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Exact origins of the web app, comma-separated. CORS allows only these, with credentials.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL 16+. Use a dedicated role rather than the postgres superuser.
# With Docker, the user, password and database must match the POSTGRES_* values below.
DATABASE_URL=postgresql://chitfund:change-me@localhost:5432/chitfund

# Redis (or Memurai on Windows). Optional: leave empty to run as a single local process.
# Use 127.0.0.1 rather than localhost on Windows, where localhost can resolve to IPv6 first.
REDIS_URL=redis://127.0.0.1:6379

# Hours a sign-in stays valid without activity (1 to 720).
SESSION_IDLE_HOURS=72

# Number of reverse proxies in front of the API (0 locally, 1 behind a load balancer).
TRUST_PROXY_HOPS=0

# true: create or replace the superadmin from the SUPERADMIN_* values at startup.
# false: leave the stored superadmin untouched (use `superadmin:create` instead).
SUPERADMIN_SEED_ON_START=false
SUPERADMIN_NAME=
# E.164 or 10-digit Indian mobile number.
SUPERADMIN_PHONE=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Web app (Vite)
# ---------------------------------------------------------------------------

# Port of the Vite dev server (`pnpm dev`) and of `vite preview`.
WEB_PORT=5173
WEB_PREVIEW_PORT=4173

# Where Vite's same-origin /api proxy forwards to. Must point at the API's PORT.
API_PROXY_TARGET=http://127.0.0.1:3000

# API base URL used by the browser. Locally the web app calls the API directly, across
# origins, through CORS. Unset it to fall back to Vite's same-origin /api proxy.
VITE_API_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# Docker Compose (docker compose up -d). Not needed without Docker.
# ---------------------------------------------------------------------------

POSTGRES_DB=chitfund
POSTGRES_TEST_DB=chitfund_test
POSTGRES_USER=chitfund
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
