# Copy to .env and fill in real values. Never commit .env.
# The API validates these at boot (apps/api/src/config/env.ts) and refuses to start if any are invalid.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Exact origins of the web app, comma-separated. CORS allows only these, with credentials.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL 16+. Use a dedicated role rather than the postgres superuser.
DATABASE_URL=postgresql://chitfund:change-me@localhost:5432/chitfund

# Redis (or Memurai on Windows). Use 127.0.0.1 rather than localhost on Windows,
# where localhost can resolve to IPv6 first.
REDIS_URL=redis://127.0.0.1:6379

# Number of reverse proxies in front of the API (0 locally, 1 behind a load balancer).
TRUST_PROXY_HOPS=0

# Web app only: API base URL. Locally the web app calls the API directly, across
# origins, through CORS. Unset it to fall back to Vite's same-origin /api proxy.
VITE_API_URL=http://localhost:3000/api
