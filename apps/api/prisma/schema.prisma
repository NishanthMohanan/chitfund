// All primary keys are UUIDv7 generated by Prisma Client. Money is integer
// paise in BIGINT. Timestamps are timestamptz; calendar dates such as due dates
// are stored as midnight Asia/Kolkata (see packages/shared/src/dates.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ORGANIZER
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

enum GroupStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  role               Role
  name               String     @db.VarChar(120)
  phone              String     @unique @db.VarChar(16)
  email              String?    @db.VarChar(254)
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordExpiresAt  DateTime?  @map("password_expires_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  totpSecret         String?    @map("totp_secret")
  totpEnabledAt      DateTime?  @map("totp_enabled_at") @db.Timestamptz(3)
  status             UserStatus @default(ACTIVE)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  organizerId        String?    @map("organizer_id") @db.Uuid
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)

  organizer              User?               @relation("OrganizerMembers", fields: [organizerId], references: [id])
  members                User[]              @relation("OrganizerMembers")
  sessions               Session[]
  memberRecords          Member[]
  paymentModes           PaymentModeMaster[]
  organizedGroups        ChitGroup[]
  chitPlanTemplates      ChitPlanTemplate[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  organizerAnnouncements Announcement[]      @relation("AnnouncementOrganizer")
  createdAnnouncements   Announcement[]      @relation("AnnouncementCreator")
  markedPayments         PaymentRecord[]     @relation("PaymentMarkedBy")
  reversedPayments       PaymentRecord[]     @relation("PaymentReversedBy")
  recordedPayouts        Payout[]
  auditLogs              AuditLog[]

  @@index([organizerId])
  @@index([role, status])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  familyId         String    @map("family_id") @db.Uuid
  deviceLabel      String?   @map("device_label") @db.VarChar(120)
  ip               String?   @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

/// A reusable chit plan, e.g. "₹50,000 over 21 months". Groups copy its month
/// schedule on creation, so later template edits never change existing groups.
model ChitPlanTemplate {
  id                 String    @id @default(uuid(7)) @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizerId        String    @map("organizer_id") @db.Uuid
  name               String    @db.VarChar(120)
  chitValue          BigInt    @map("chit_value")
  memberCount        Int       @map("member_count")
  durationMonths     Int       @map("duration_months")
  /// Fixed for every month of the plan, month 1 included.
  monthlyInstallment BigInt    @map("monthly_installment")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(3)

  organizer User                    @relation(fields: [organizerId], references: [id])
  months    ChitPlanTemplateMonth[]
  groups    ChitGroup[]

  @@unique([organizerId, name])
  @@map("chit_plan_templates")
}

model ChitPlanTemplateMonth {
  id               String   @id @default(uuid(7)) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  templateId       String   @map("template_id") @db.Uuid
  monthNumber      Int      @map("month_number")
  /// Exact amount the month's recipient receives. Set per month by the organizer; zero for the organizer's month.
  payoutAmount     BigInt   @map("payout_amount")
  /// The month's collection is the organizer's commission; no member payout.
  isOrganizerMonth Boolean  @default(false) @map("is_organizer_month")

  template ChitPlanTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId, monthNumber])
  @@map("chit_plan_template_months")
}

model ChitGroup {
  id                 String      @id @default(uuid(7)) @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizerId        String      @map("organizer_id") @db.Uuid
  templateId         String?     @map("template_id") @db.Uuid
  name               String      @db.VarChar(120)
  code               String      @db.VarChar(32)
  chitValue          BigInt      @map("chit_value")
  memberCount        Int         @map("member_count")
  durationMonths     Int         @map("duration_months")
  monthlyInstallment BigInt      @map("monthly_installment")
  startDate          DateTime    @map("start_date") @db.Timestamptz(3)
  dueDayOfMonth      Int         @map("due_day_of_month")
  status             GroupStatus @default(DRAFT)
  showRecipientNames Boolean     @default(false) @map("show_recipient_names")
  activatedAt        DateTime?   @map("activated_at") @db.Timestamptz(3)

  organizer     User              @relation(fields: [organizerId], references: [id])
  template      ChitPlanTemplate? @relation(fields: [templateId], references: [id])
  months        ChitGroupMonth[]
  tickets       Ticket[]
  payouts       Payout[]
  announcements Announcement[]

  @@unique([organizerId, code])
  @@index([organizerId, status])
  @@map("chit_groups")
}

/// The group's own month schedule, copied from its template and editable per group.
model ChitGroupMonth {
  id               String   @id @default(uuid(7)) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  groupId          String   @map("group_id") @db.Uuid
  monthNumber      Int      @map("month_number")
  dueDate          DateTime @map("due_date") @db.Timestamptz(3)
  payoutAmount     BigInt   @map("payout_amount")
  isOrganizerMonth Boolean  @default(false) @map("is_organizer_month")

  group ChitGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, monthNumber])
  @@map("chit_group_months")
}

/// A person enrolled by the organizer. Members do not sign in.
model Member {
  id            String   @id @default(uuid(7)) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizerId   String   @map("organizer_id") @db.Uuid
  name          String   @db.VarChar(120)
  phone         String   @db.VarChar(16)
  phoneVerified Boolean  @default(false) @map("phone_verified")
  address       String?  @db.VarChar(500)
  idProofType   String?  @map("id_proof_type") @db.VarChar(60)
  idProofNumber String?  @map("id_proof_number") @db.VarChar(60)
  nomineeName   String?  @map("nominee_name") @db.VarChar(120)
  nomineePhone  String?  @map("nominee_phone") @db.VarChar(16)
  notes         String?  @db.VarChar(1000)

  organizer User            @relation(fields: [organizerId], references: [id])
  tickets   Ticket[]
  holdings  TicketHolder[]
  payments  PaymentRecord[]

  @@unique([organizerId, phone])
  @@index([organizerId, name])
  @@map("members")
}

/// Master list of payment modes (Cash, UPI, Bank transfer, ...).
model PaymentModeMaster {
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizerId String   @map("organizer_id") @db.Uuid
  name        String   @db.VarChar(60)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")

  organizer User            @relation(fields: [organizerId], references: [id])
  payments  PaymentRecord[]
  payouts   Payout[]

  @@unique([organizerId, name])
  @@map("payment_modes")
}

/// A seat in a group. Dues and payments belong to the ticket, so a replacement
/// member takes over the ticket and its history stays intact.
model Ticket {
  id           String   @id @default(uuid(7)) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  groupId      String   @map("group_id") @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  ticketNumber Int      @map("ticket_number")

  group    ChitGroup       @relation(fields: [groupId], references: [id])
  member   Member          @relation(fields: [memberId], references: [id])
  holders  TicketHolder[]
  payments PaymentRecord[]
  payout   Payout?

  @@unique([groupId, ticketNumber])
  @@index([memberId])
  @@map("tickets")
}

/// Who held a ticket and from which month. A member leaving closes their row.
model TicketHolder {
  id         String    @id @default(uuid(7)) @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  ticketId   String    @map("ticket_id") @db.Uuid
  memberId   String    @map("member_id") @db.Uuid
  fromMonth  Int       @map("from_month")
  leftAt     DateTime? @map("left_at") @db.Timestamptz(3)
  leftReason String?   @map("left_reason") @db.VarChar(500)

  ticket Ticket @relation(fields: [ticketId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([ticketId])
  @@index([memberId])
  @@map("ticket_holders")
}

/// Money received for a ticket. Any amount; it settles the oldest dues first.
/// Never deleted: a mistake is reversed.
model PaymentRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  ticketId       String    @map("ticket_id") @db.Uuid
  payerMemberId  String    @map("payer_member_id") @db.Uuid
  amount         BigInt
  modeId         String    @map("mode_id") @db.Uuid
  reference      String?   @db.VarChar(120)
  note           String?   @db.VarChar(500)
  paidOn         DateTime  @map("paid_on") @db.Timestamptz(3)
  markedById     String    @map("marked_by_id") @db.Uuid
  markedAt       DateTime  @default(now()) @map("marked_at") @db.Timestamptz(3)
  reversedById   String?   @map("reversed_by_id") @db.Uuid
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversalReason String?   @map("reversal_reason") @db.VarChar(500)

  ticket     Ticket            @relation(fields: [ticketId], references: [id])
  payer      Member            @relation(fields: [payerMemberId], references: [id])
  mode       PaymentModeMaster @relation(fields: [modeId], references: [id])
  markedBy   User              @relation("PaymentMarkedBy", fields: [markedById], references: [id])
  reversedBy User?             @relation("PaymentReversedBy", fields: [reversedById], references: [id])

  @@index([ticketId, reversedAt])
  @@index([paidOn])
  @@map("payment_records")
}

/// The chit amount handed to a ticket for a month. The organizer decides the
/// amount when recording it, and it is copied to that month's schedule.
model Payout {
  id           String   @id @default(uuid(7)) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  groupId      String   @map("group_id") @db.Uuid
  monthNumber  Int      @map("month_number")
  ticketId     String   @unique @map("ticket_id") @db.Uuid
  amount       BigInt
  paidOn       DateTime @map("paid_on") @db.Timestamptz(3)
  modeId       String?  @map("mode_id") @db.Uuid
  reference    String?  @db.VarChar(120)
  recordedById String   @map("recorded_by_id") @db.Uuid
  note         String?  @db.VarChar(500)

  group      ChitGroup          @relation(fields: [groupId], references: [id])
  ticket     Ticket             @relation(fields: [ticketId], references: [id])
  mode       PaymentModeMaster? @relation(fields: [modeId], references: [id])
  recordedBy User               @relation(fields: [recordedById], references: [id])

  @@unique([groupId, monthNumber])
  @@map("payouts")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(1000)
  link      String?   @db.VarChar(300)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id         String    @id @default(uuid(7)) @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_subscriptions")
}

model Announcement {
  id          String   @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizerId String   @map("organizer_id") @db.Uuid
  groupId     String?  @map("group_id") @db.Uuid
  title       String   @db.VarChar(160)
  body        String   @db.VarChar(4000)
  createdById String   @map("created_by_id") @db.Uuid

  organizer User       @relation("AnnouncementOrganizer", fields: [organizerId], references: [id])
  group     ChitGroup? @relation(fields: [groupId], references: [id])
  createdBy User       @relation("AnnouncementCreator", fields: [createdById], references: [id])

  @@index([organizerId, createdAt])
  @@index([groupId])
  @@map("announcements")
}

/// Append-only. UPDATE and DELETE are rejected by a trigger (see migration 0001_init).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
